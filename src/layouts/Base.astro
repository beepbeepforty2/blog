---
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import ThemeSelector from '../components/ThemeSelector.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
}

const {
  title,
  description = 'Notes on software, systems, and building things.',
  type = 'website',
  publishedTime,
  updatedTime,
} = Astro.props;
const siteName = 'Pratik’s notes';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

// Canonical URL: same form as the trailing-slash 301s enforce.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;

// Google Search Console ownership token (HTML-tag method).
// Paste the content="..." value from GSC here; leave empty to omit the tag.
const googleSiteVerification = 'tMErjo8MKOZd0tFoQJ6v6xhdMs_Di6HARVBuwXcY_R8';

// Boot-line stats (footer). Keep the themes count in sync with ThemeSelector.
const publishedPosts = await getCollection('posts', ({ data }) => !data.draft);
const siteLaunch = '2026-08-11'; // first deploy
const uptimeDays = Math.floor((Date.now() - new Date(siteLaunch).getTime()) / 864e5);
---

<!doctype html>
<!--

     ✦  undiscoveredmaterials.com  ✦

   no trackers, no cookies, no dark patterns —
   just honest HTML and one friendly cow.

 ____________________________
< hi, curious source reader! >
 ----------------------------
        \   ^__^
         \  (oo)\_______
            (__)\       )\/\
                ||----w |
                ||     ||

-->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22 fill=%22%23888888%22>✦</text></svg>`} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={`${base}rss.xml`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'gruvbox-dark' : 'gruvbox-light');
          document.documentElement.setAttribute('data-theme', theme);
          let mode = localStorage.getItem('theme-mode');
          if (mode !== 'dark' && mode !== 'light') mode = prefersDark ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme-mode', mode);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'gruvbox-dark');
          document.documentElement.setAttribute('data-theme-mode', 'dark');
        }
      })();
    </script>
    <script is:inline>
      (function () {
        var base = document.title;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) {
          var i = 0;
          var t = setInterval(function () {
            if (document.hidden) return;
            document.title = i % 2 === 0 ? base + ' ▊' : base;
            if (++i >= 6) {
              clearInterval(t);
              document.title = base;
            }
          }, 450);
        }
        document.addEventListener('visibilitychange', function () {
          document.title = document.hidden ? 'bye 👋' : base;
        });
      })();
    </script>
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <header class="site-header">
      <a class="site-name" href={base}>{siteName}</a>
      <div class="header-right">
        <nav aria-label="Main navigation">
          <a href={base}>Writing</a>
          <a href={`${base}about/`}>About</a>
          <a href={`/resume/`}>Résumé</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color mode">
          <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
        </button>
      </div>
    </header>
    <ThemeSelector />
    <main>
      <slot />
    </main>
    <footer>
      <span>Built with Astro. No tracking, no cookies.</span>
      <span class="boot-line" data-launch={siteLaunch}>
        uptime: {uptimeDays}d · posts: {publishedPosts.length} · themes: 20 · tracking: 0
      </span>
    </footer>
    <script is:inline>
      (function () {
        var el = document.querySelector('.boot-line');
        if (!el) return;
        var days = Math.floor((Date.now() - new Date(el.dataset.launch)) / 864e5);
        el.textContent = el.textContent.replace(/uptime: \d+d/, 'uptime: ' + days + 'd');
      })();
    </script>
    <script is:inline>
      (function () {
        var glow = document.querySelector('.cursor-glow');
        if (!glow) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var hide = null;
        var raf = null;
        document.addEventListener(
          'mousemove',
          function (e) {
            if (raf) return;
            raf = requestAnimationFrame(function () {
              raf = null;
              var s = document.documentElement.style;
              s.setProperty('--glow-x', e.clientX + 'px');
              s.setProperty('--glow-y', e.clientY + 'px');
              glow.style.opacity = '1';
            });
            clearTimeout(hide);
            hide = setTimeout(function () {
              glow.style.opacity = '0';
            }, 1800);
          },
          { passive: true }
        );
        document.documentElement.addEventListener('mouseleave', function () {
          clearTimeout(hide);
          glow.style.opacity = '0';
        });
      })();
    </script>
  </body>
</html>
