---
import 'katex/dist/katex.min.css';
import ThemeSelector from '../components/ThemeSelector.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Notes on software, systems, and building things.',
} = Astro.props;
const siteName = 'Pratik’s notes';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

// Google Search Console ownership token (HTML-tag method).
// Paste the content="..." value from GSC here; leave empty to omit the tag.
const googleSiteVerification = 'tMErjo8MKOZd0tFoQJ6v6xhdMs_Di6HARVBuwXcY_R8';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✦</text></svg>`} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={`${base}rss.xml`} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          if (stored) {
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const defaultTheme = prefersDark ? 'gruvbox-dark' : 'gruvbox-light';
            document.documentElement.setAttribute('data-theme', defaultTheme);
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'gruvbox-dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={base}>{siteName}</a>
      <div class="header-right">
        <nav aria-label="Main navigation">
          <a href={base}>Writing</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </nav>
      </div>
    </header>
    <ThemeSelector />
    <main>
      <slot />
    </main>
    <footer>
      <span>Built with Astro. No tracking, no cookies.</span>
    </footer>
  </body>
</html>
