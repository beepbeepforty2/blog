---
import Base from '../layouts/Base.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<Base title="Résumé" description="Résumé of Pratik Chatse — Sr. Software Engineer specializing in Computer Vision, Machine Learning, Deep Learning, and Reinforcement Learning.">
  <article class="prose resume">
    <h1>Pratik Chatse</h1>
    <p class="resume-headline">
      Sr. Software Engineer (Computer Vision, ML, Deep Learning, Reinforcement Learning)
    </p>
    <p class="post-meta">
      Bengaluru, India · <a href="https://github.com/beepbeepforty2">GitHub</a> · <a href={base}>Blog</a>
    </p>

    <h2>Summary</h2>
    <p>
      Senior Software Engineer with over 5 years of experience specializing in Machine Learning,
      Computer Vision, and Deep Learning. Proven expertise in developing and deploying
      production-level AI solutions on cloud and edge devices, particularly within the medical
      domain. Adept at model optimization, automation, and working in fast-paced, agile
      environments. Holds an M.Tech in Medical Imaging from IIT Kharagpur.
    </p>

    <h2>Skills</h2>
    <dl class="resume-skills">
      <dt>ML Frameworks &amp; Libraries</dt>
      <dd>PyTorch, TensorFlow, Scikit-learn, OpenCV, NumPy, Pandas, Matplotlib</dd>
      <dt>Languages</dt>
      <dd>Python, Elementary C, Bash scripting (novice)</dd>
      <dt>Cloud &amp; DevOps</dt>
      <dd>AWS (SageMaker), GKE, Azure, Docker, CI/CD, Bitbucket</dd>
      <dt>Tools &amp; Technologies</dt>
      <dd>Git, Linux, TensorRT, Raspberry Pi, Arduino, IoT, MATLAB</dd>
      <dt>Expertise</dt>
      <dd>Computer Vision, Deep Learning, Reinforcement Learning, Model Optimization, MLOps,
        Edge Computing, Data Science, Image Processing</dd>
    </dl>

    <h2>Professional Experience</h2>

    <section class="resume-entry">
      <h3>Sr. Software Engineer (Machine Learning)</h3>
      <p class="post-meta">Feb 2019 – Feb 2025 (6 years) · Bengaluru, India</p>
      <ul>
        <li>
          Engineered and deployed real-time AI inference models on edge devices (Raspberry Pi) for
          live analysis of medical videos, providing AI-assisted annotations during colonoscopy
          procedures.
        </li>
        <li>Developed and maintained production-level Python code within a CI/CD pipeline using Jenkins and Bitbucket.</li>
        <li>
          Utilized AWS SageMaker and GPU instances for cloud-based model training, evaluation, and
          automation, focusing on model drift and performance monitoring. Optimized model inference
          latency using NVIDIA TensorRT containers and containerized model serving for edge
          deployment.
        </li>
        <li>Led data science experimentation, data curation, and root-cause analysis to improve model accuracy and resolve non-convergence issues.</li>
        <li>
          Implemented solutions for fine-grained object detection with limited data and upgraded
          models to the latest State-of-the-Art (SOTA) architectures for performance improvements.
        </li>
        <li>Developed dashboards for data visualization and KPI tracking, and created high-level design documents for new product features.</li>
        <li>Mentored and managed junior engineers and interns, leading a geographically distributed team.</li>
      </ul>
    </section>

    <section class="resume-entry">
      <h3>Embedded IoT Engineer</h3>
      <p class="post-meta">2018 (2 months) · Singapore</p>
      <ul>
        <li>Prototyped IoT solutions for a marine chemical logistics platform using Raspberry Pi and Arduino.</li>
        <li>Integrated various IoT sensors and devices, working with common communication protocols.</li>
        <li>Contributed to a SaaS platform providing dashboarding and navigation for ship oil tankers.</li>
      </ul>
    </section>

    <h2>Projects</h2>

    <section class="resume-entry">
      <h3>Standalone Digital Microscopy &amp; CAD Device</h3>
      <p class="post-meta">M.Tech Project · June 2017 – June 2018</p>
      <p>
        Developed a low-cost, standalone diagnostic device using Raspberry Pi for rapid cellular
        and hematological imaging. Implemented on-board image processing and machine learning for
        point-of-care diagnostics.
      </p>
      <p class="resume-tech">Raspberry Pi, Arduino, Machine Learning, Deep Learning, IoT, Motor Control</p>
    </section>

    <section class="resume-entry">
      <h3>Motor Imagery Classification for Brain-Computer Interface</h3>
      <p class="post-meta">B.Tech Project</p>
      <p>Implemented a system to classify EEG brain signals for a binary man-machine interface.</p>
      <p class="resume-tech">MATLAB, Biomedical Signal Processing</p>
    </section>

    <h2>Education</h2>

    <section class="resume-entry">
      <h3>M.Tech, Medical Imaging and Informatics</h3>
      <p class="post-meta">Indian Institute of Technology (IIT), Kharagpur · 2016 – 2018</p>
    </section>

    <section class="resume-entry">
      <h3>B.E., Electronics and Communication Engineering</h3>
      <p class="post-meta">Birla Institute of Technology (BIT), Mesra · 2008 – 2012</p>
    </section>
  </article>
</Base>

<style>
  .resume .resume-headline {
    font-size: 1.05rem;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .resume .resume-skills {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    gap: 0.45rem 1.25rem;
    margin: 0;
  }

  .resume .resume-skills dt {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .resume .resume-skills dd {
    margin: 0;
    color: var(--muted);
  }

  .resume .resume-entry {
    margin-bottom: 2rem;
  }

  .resume .resume-entry h3 {
    margin-bottom: 0.15rem;
  }

  .resume .resume-tech {
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 36rem) {
    .resume .resume-skills {
      grid-template-columns: 1fr;
      gap: 0.1rem 0;
    }

    .resume .resume-skills dd {
      margin-bottom: 0.45rem;
    }
  }
</style>
