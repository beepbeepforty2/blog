---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<Base>
  <section class="intro">
    <h1>Writing</h1>
    <p>Notes on software, systems, and the details that make them work.</p>
  </section>

  <ol class="post-list">
    {posts.map((post) => (
      <li>
        <article>
          <time datetime={post.data.published.toISOString()}>
            {post.data.published.toLocaleDateString('en', {
              year: 'numeric',
              month: 'short',
              day: '2-digit',
              timeZone: 'UTC',
            })}
          </time>
          <div>
            <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </div>
        </article>
      </li>
    ))}
  </ol>
</Base>
