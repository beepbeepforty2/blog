# Long-cache fingerprinted-or-stable static files. HTML keeps Cloudflare's
# default max-age=0, must-revalidate so new posts show up immediately.
# CSS/JS URLs carry a content hash query so deploys bust the browser cache.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/giallo-dark.css
  Cache-Control: public, max-age=86400

/giallo-light.css
  Cache-Control: public, max-age=86400
